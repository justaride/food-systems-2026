{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodsystems.local/schemas/field08-human-review-pending-template.schema.v1.json",
  "title": "Field 08 Gate 2C pending human-review work packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "templateId",
    "status",
    "sourceCommit",
    "evidencePackage",
    "evidencePackageHash",
    "reviewGateId",
    "gateType",
    "requiredReviewerRole",
    "instructions",
    "allowedDispositions",
    "targetBindings",
    "locatorBindings",
    "sourceAppraisalBindings",
    "receiptRequirements",
    "externalGatePassed",
    "coveragePromotionAllowed",
    "contentHash"
  ],
  "properties": {
    "documentType": { "const": "field08_human_review_pending_template" },
    "schemaVersion": { "const": "1.0.0" },
    "templateId": {
      "type": "string",
      "pattern": "^review_template\\.field08\\.(boundary-reconciliation|contradiction-resolution|method-appraisal|ordinary-human-review)\\.v1$"
    },
    "status": { "const": "pending_human_review" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "evidencePackage": { "$ref": "#/$defs/evidencePackage" },
    "evidencePackageHash": { "$ref": "#/$defs/sha256" },
    "reviewGateId": {
      "enum": [
        "review_gate.field08.boundary-reconciliation",
        "review_gate.field08.contradiction-resolution",
        "review_gate.field08.method-appraisal",
        "review_gate.field08.ordinary-human-review"
      ]
    },
    "gateType": {
      "enum": ["boundary_reconciliation", "contradiction_resolution", "method_appraisal", "ordinary_human_review"]
    },
    "requiredReviewerRole": { "type": "string", "minLength": 2 },
    "instructions": { "type": "string", "minLength": 20 },
    "allowedDispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "verified_as_scoped",
          "resolved",
          "amendments_required",
          "rejected",
          "retain_open",
          "needs_new_source",
          "deferred_insufficient_evidence"
        ]
      },
      "uniqueItems": true
    },
    "targetBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/targetBinding" }
    },
    "locatorBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/locatorBinding" }
    },
    "sourceAppraisalBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceAppraisalBinding" }
    },
    "receiptRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appendOnlyJsonl",
        "fullSnapshotPerReceipt",
        "namedHumanRequired",
        "utcTimestampRequired",
        "attestationRequired",
        "supersessionChainRequired",
        "exactBindingsRequired"
      ],
      "properties": {
        "appendOnlyJsonl": { "const": true },
        "fullSnapshotPerReceipt": { "const": true },
        "namedHumanRequired": { "const": true },
        "utcTimestampRequired": { "const": true },
        "attestationRequired": { "const": true },
        "supersessionChainRequired": { "const": true },
        "exactBindingsRequired": { "const": true }
      }
    },
    "externalGatePassed": { "const": false },
    "coveragePromotionAllowed": { "const": false },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileSha256", "contentHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidencePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hashSemantics",
        "bindingContract",
        "sourceCommit",
        "generationManifest",
        "reviewManifest",
        "intake",
        "sourceBindings",
        "locatorBindings"
      ],
      "properties": {
        "hashSemantics": { "const": "canonical_json_sorted_keys_v1" },
        "bindingContract": { "const": "field08_gate2c_source_acquisition_citation_v1" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "generationManifest": { "$ref": "#/$defs/artifactBinding" },
        "reviewManifest": { "$ref": "#/$defs/artifactBinding" },
        "intake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fileSha256"],
          "properties": {
            "path": { "const": "knowledge/pilots/field08/gate2c/field08-evidence-intake.v1.json" },
            "fileSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "sourceBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceBinding" }
        },
        "locatorBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/packageLocatorBinding" }
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceSha256"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^fs:source:" },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageLocatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceSha256",
        "acquisitionId",
        "acquisitionSha256",
        "citationId",
        "citationSha256",
        "captureSha256"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^fs:source:" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "acquisitionId": { "type": "string", "pattern": "^acq\\.field08\\." },
        "acquisitionSha256": { "$ref": "#/$defs/sha256" },
        "citationId": { "type": "string", "pattern": "^fs:citation:" },
        "citationSha256": { "$ref": "#/$defs/sha256" },
        "captureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetKind", "targetSha256"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "targetKind": {
          "enum": ["source", "acquisition", "claim", "observation", "contradiction_set", "appraisal_draft"]
        },
        "targetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceSha256",
        "acquisitionId",
        "acquisitionSha256",
        "citationId",
        "citationSha256",
        "captureSha256",
        "locator"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^fs:source:" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "acquisitionId": { "type": "string", "pattern": "^acq\\.field08\\." },
        "acquisitionSha256": { "$ref": "#/$defs/sha256" },
        "citationId": { "type": "string", "pattern": "^fs:citation:" },
        "citationSha256": { "$ref": "#/$defs/sha256" },
        "captureSha256": { "$ref": "#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "sourceAppraisalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceSha256", "appraisalDraftId", "appraisalDraftSha256"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^fs:source:" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "appraisalDraftId": { "type": "string", "pattern": "^appraisal\\.field08\\." },
        "appraisalDraftSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
