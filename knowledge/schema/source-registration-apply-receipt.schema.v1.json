        "planStyleMigrationLedgerSha256": { "$ref": "#/$defs/sha256" },
        "backupStyleMigrationLedgerSha256": { "$ref": "#/$defs/sha256" },
        "preApplyTargetFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "afterApplyTargetFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "targetSetSha256": { "$ref": "#/$defs/sha256" },
        "documentRowsSha256": { "$ref": "#/$defs/sha256" },
        "libraryAnalysisRowsSha256": { "$ref": "#/$defs/sha256" },
        "dependencyRowsSha256": { "$ref": "#/$defs/sha256" },
        "dependencyRowCount": { "const": 0 },
        "counts": {
          "type": "object",
          "required": [
            "documents",
            "libraryAnalysisRecords",
            "controlledMutationAuditsBeforeAppend",
            "controlledMutationAuditsAfterAppend"
          ],
          "properties": {
            "documents": { "$ref": "#/$defs/nonnegativeInteger" },
            "libraryAnalysisRecords": { "$ref": "#/$defs/nonnegativeInteger" },
            "controlledMutationAuditsBeforeAppend": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "controlledMutationAuditsAfterAppend": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          },
          "additionalProperties": false
        },
        "afterSnapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "object",
      "required": [
        "documentCreates",
        "libraryAnalysisRecordCreates",
        "controlledMutationAuditCreates",
        "privateRecoveryRegisterWrites",
        "corpusRegisterWrites",
        "lifecycleEventWrites",
        "citationCreates",
        "appraisalCreates"
