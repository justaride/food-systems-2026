            "binaryFileSha256": { "$ref": "#/$defs/sha256" },
            "platform": { "$ref": "#/$defs/safeText" },
            "runtimeClosureManifestSha256": { "$ref": "#/$defs/sha256" },
            "runtimeClosureSha256": {
              "const": "464410ef7bbe3c4da7468973f47a43442b51ef7ff3455d810dcf8f3b7ae4e434"
            },
            "runtimeClosureVerifierFileSha256": {
              "$ref": "#/$defs/sha256"
            },
            "version": { "$ref": "#/$defs/safeText" }
          },
          "additionalProperties": false
        },
        "nodeModules": {
          "allOf": [
            { "$ref": "#/$defs/resolvedTree" },
            {
              "type": "object",
              "properties": { "path": { "const": "node_modules" } }
            }
          ]
        },
        "prismaGeneratedClient": {
          "allOf": [
            { "$ref": "#/$defs/resolvedTree" },
            {
              "type": "object",
