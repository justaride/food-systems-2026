      "additionalProperties": false
    },
    "runtimeAttestation": {
      "type": "object",
      "required": [
        "schemaVersion",
        "launcher",
        "localClosure",
        "node",
        "nodeModules",
        "prismaGeneratedClient",
        "postgresqlToolset",
        "runtimeAttestationSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "source-registration-runtime-attestation-v1"
        },
        "launcher": {
          "type": "object",
          "required": ["path", "fileSha256"],
          "properties": {
            "path": {
              "const": "scripts/knowledge/launch-locked-source-registration-apply.mjs"
            },
            "fileSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "localClosure": {
          "type": "object",
          "required": [
            "closureSha256",
            "entryCount",
            "roots",
            "totalFileBytes"
          ],
          "properties": {
            "closureSha256": { "$ref": "#/$defs/sha256" },
            "entryCount": { "$ref": "#/$defs/positiveInteger" },
            "roots": {
              "type": "array",
              "prefixItems": [
                { "const": "package.json" },
                {
                  "const": "knowledge/runtime/source-registration-tsx.runtime.json"
                },
                {
                  "const": "scripts/knowledge/apply-source-registration-plan.ts"
                },
                {
                  "const": "scripts/knowledge/run-source-registration-logical-clone-rehearsal.ts"
                },
                {
                  "const": "scripts/knowledge/run-controlled-logical-restore-companion.mjs"
                },
                {
                  "const": "scripts/knowledge/logical-restore-receipt-pair-journal.mjs"
                },
                {
                  "const": "scripts/knowledge/launch-locked-source-registration-apply.mjs"
                },
                {
                  "const": "scripts/knowledge/database-logical-state-digest.mjs"
                },
                {
                  "const": "scripts/knowledge/verify-psql-runtime-closure.mjs"
                },
                {
                  "const": "scripts/knowledge/verify-node-runtime-closure.mjs"
                },
                {
                  "const": "scripts/knowledge/generate-source-registration-plan.ts"
                }
              ],
              "items": false,
              "minItems": 11,
              "maxItems": 11
            },
            "totalFileBytes": { "$ref": "#/$defs/positiveInteger" }
          },
          "additionalProperties": false
        },
        "node": {
          "type": "object",
          "required": [
            "arch",
            "binaryFileSha256",
            "platform",
            "runtimeClosureManifestSha256",
            "runtimeClosureSha256",
            "runtimeClosureVerifierFileSha256",
            "version"
          ],
          "properties": {
