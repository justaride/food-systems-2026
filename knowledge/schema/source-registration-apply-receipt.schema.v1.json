      "additionalProperties": false
    },
    "resolvedTree": {
      "type": "object",
      "required": [
        "entryCount",
        "fileCount",
        "path",
        "rootKind",
        "symlinkCount",
        "totalFileBytes",
        "treeSha256"
      ],
      "properties": {
        "entryCount": { "$ref": "#/$defs/positiveInteger" },
        "fileCount": { "$ref": "#/$defs/positiveInteger" },
        "path": { "$ref": "#/$defs/portablePath" },
        "rootKind": { "const": "resolved_external_symlink" },
