        "afterApplyTargetFingerprintSha256",
        "targetSetSha256",
        "documentRowsSha256",
        "libraryAnalysisRowsSha256",
        "dependencyRowsSha256",
        "dependencyRowCount",
        "counts",
        "afterSnapshotSha256"
      ],
      "properties": {
        "databaseIdentityUuid": { "$ref": "#/$defs/uuid" },
