        "DatabaseIdentity": { "const": 1 },
        "Document": { "$ref": "#/$defs/nonnegativeInteger" },
        "EvidenceAppraisal": { "$ref": "#/$defs/nonnegativeInteger" },
        "FieldCitation": { "$ref": "#/$defs/nonnegativeInteger" },
        "LibraryAnalysisRecord": { "$ref": "#/$defs/nonnegativeInteger" },
        "Report": { "$ref": "#/$defs/nonnegativeInteger" },
        "SourceCitation": { "$ref": "#/$defs/nonnegativeInteger" },
        "SourceDoc": { "$ref": "#/$defs/nonnegativeInteger" },
        "Thesis": { "$ref": "#/$defs/nonnegativeInteger" }
