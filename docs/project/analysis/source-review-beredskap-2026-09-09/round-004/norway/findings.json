  "definitions": {
    "geography": "Region0, Hele landet. County polygons/boundary continuity were not verified; no county comparison claimed.",
    "production": "SSB table04609 reports deliveries of cereals for sale; own-use grain excluded by published methodology. Not all physically harvested grain.",
    "area": "Table04607 crop area of agricultural holdings; final statistics use SSB total agricultural-holding population. Not relabelled as successfully harvested area.",
    "wheat": "Kveite in production mapped to Hvete total area; includes spring/winter wheat together. No food/feed-grade split. Spelt membership not explicit in these SSB metadata, so Eurostat C1100 wheat-and-spelt equivalence remains conditional.",
    "moisture": "15 percent water content stated in production API note0, applies to selected table.",
    "unitConversions": {
      "productionTonnes": "04609 value in1000 tonnes *1000",
      "areaHectares": "04607 value in decares /10",
      "derivedYieldKgPerDecare": "productionTonnes *1000 / areaDecares",
      "derivedYieldTonnesPerHectare": "productionTonnes / areaHectares",
      "conditionalProductionAt14PercentMoistureTonnes": "productionTonnes * (100-15)/(100-14) = productionTonnes *85/86; dry matter conservation only"
    },
    "precision": "Production published to0.1 thousand tonnes; area published as whole decares. Computed decimal yields retain arithmetic reproducibility, not measurement precision.",
    "temporalCaution": "Both responses carry ContentsCode.extension.refperiod=31.07 and measuringType=Stock. These raw labels are preserved as metadata anomalies/definition gaps; annual grain output is NOT interpreted as inventory on31July.",
    "statisticalIndependence": "This is a separate original extraction, not an independent measurement population: SSB states it reports to Eurostat and FAO. Differences from Eurostat require source/concept reconciliation, not voting between independent sources."
  },
