// ─── Domain 9: Market Data ──────────────────────────────────────────

model CountryMetric {
  id         String  @id @default(cuid())
  country    String // DB-canonical uppercase ISO: NO, SE, DK, FI, IS, Nordic, EU
  metricType String // selfSufficiency, margin, marketShare
  category   String // e.g. "Melk", "Kjøtt", "NorgesGruppen"
  value      Decimal @db.Decimal(10, 2)
  unit       String? // %, NOK, etc.
  year       String
  source     String
  subtitle   String?
  metadata   Json?

  @@unique([country, metricType, category, year])
  @@index([country, metricType])
}

// ─── Domain 9b: Aquaculture & Agricultural Operations ──────────────

model AquacultureSite {
  id             String  @id @default(cuid())
  localityNumber String  @unique
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])

  siteName       String?
  municipality   String?
  municipalityNo String?
  county         String?
  country        String  @default("NO")
  lat            Float?
  lng            Float?

  licenseStatus     String? // aktiv, paused, revoked
  placement         String? // SJØ, HAV, LAND
  waterType         String? // seawater, freshwater
  capacityTonnes    Float?
  capacityUnit      String?  @default("MTB")
  species           String[]
  productionTypes   String[]
  licenseIssuedYear Int?

  source    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthObservations FishHealthObservation[]

  @@index([companyId])
  @@index([licenseStatus])
  @@index([municipalityNo])
}

model FishHealthObservation {
  id     String          @id @default(cuid())
  siteId String
  site   AquacultureSite @relation(fields: [siteId], references: [id])

  year            Int
  week            Int
  observationDate DateTime?

  avgAdultFemaleLice     Float?
  avgMobileLice          Float?
  avgStationaryLice      Float?
  seaTemperature         Float?
  isFallow               Boolean @default(false)
  hasReportedLice        Boolean @default(false)
  hasBathTreatment       Boolean @default(false)
  hasInFeedTreatment     Boolean @default(false)
  hasMechanicalRemoval   Boolean @default(false)
  hasCleanerFishDeployed Boolean @default(false)

  diseaseType   String?
  diseaseStatus String?
  diseaseNote   String?

  source    String   @default("BarentsWatch")
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([siteId, year, week, diseaseType])
  @@index([siteId])
  @@index([year, week])
  @@index([diseaseType])
}

model AquacultureApplication {
  id             String   @id @default(cuid())
  applicationNo  String   @unique
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  applicantOrgNr String
  applicantName  String?

  applicationType String?
  title           String?
  status          String? // SUBMITTED, PROCESSED, WITHDRAWN, RETURNED, OTHER
  result          String? // GRANTED, DENIED, NO_DECISION, FOLLOWS_REGULATIONS

  submittedAt          DateTime?
  createdAt            DateTime?
  evaluationFinishedAt DateTime?
  withdrawnAt          DateTime?

  source    String   @default("Fiskeridirektoratet")
  metadata  Json?
  fetchedAt DateTime @default(now())

  @@index([companyId])
  @@index([applicantOrgNr])
  @@index([status])
}

model DeliveryVolume {
  id                 String    @id @default(cuid())
  supplierId         String?
  supplierProducerId String?
  supplier           Company?  @relation("DeliverySupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierProducer   Producer? @relation("DeliverySupplierProducer", fields: [supplierProducerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierOrgNr      String
  buyerId            String?
  buyer              Company?  @relation("DeliveryBuyer", fields: [buyerId], references: [id])
  buyerName          String?

  commodity String // melk-ku, melk-geit, egg, korn, slakt-storfe, slakt-svin, slakt-saue, slakt-fjorfe
  year      Int
  quantity  Float
  unit      String // liter, kg, tonn
  kommuneNr String?

  source    String   @default("Landbruksdirektoratet")
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([supplierOrgNr, commodity, year])
  @@index([supplierId])
  @@index([supplierProducerId])
  @@index([buyerId])
  @@index([commodity, year])
}

// ─── Domain 10: Media Landscape ─────────────────────────────────────

model MediaTheme {
