  evidenceNote    String?
  codedBy         String
  createdAt       DateTime @default(now())

  entry MediaEntry @relation(fields: [entryId], references: [id])

  @@unique([entryId, primaryTheme, tone, frame])
  @@index([entryId])
  @@index([country, primaryTheme])
  @@index([tone])
  @@index([frame])
}
