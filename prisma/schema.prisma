generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm(map: "pg_trgm"), vector(map: "vector")]
}

enum SourceClass {
  primary
  secondary
  dataset
  internal_synthesis
  media
  unknown
  synthesis
  internal_construct
  registry_snapshot
  legacy_unsourced
}

enum VerificationStatus {
  verified
  partially_verified
  needs_review
  failed
  unverified
  machine_verified
  human_verified
  disputed
  rejected
}

enum CitationReadiness {
  citable_external
  citable_with_note
  internal_context
  blocked_unsourced
}

// ─── Domain 1: Documents ────────────────────────────────────────────

model Document {
  id            String                       @id @default(cuid())
  slug          String                       @unique
  filePath      String?                      @unique
  title         String
  author        String?
  year          Int?
  documentType  String?
  category      String?
  subcategory   String?
  country       String?
  content       String
  summary       String?
  url           String?
  accessedAt    DateTime?
  archivedUrl   String?
  wordCount     Int                          @default(0)
  tags          String[]
  metadata      Json?
  embedding     Unsupported("vector(1536)")?
  // search_vector: FTS-kolonne lagt til via raw SQL (scripts/add-postgres-fts.sql)
  // GENERATED ALWAYS AS (...) STORED — Prisma kan ikke uttrykke dette, men
  // erklæring her hindrer `prisma db push` fra å droppe kolonnen.
  search_vector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refsFrom            DocumentRef[]        @relation("refFrom")
  refsTo              DocumentRef[]        @relation("refTo")
  sourceDoc           SourceDoc?           @relation
  thesis              Thesis?              @relation
  report              Report?              @relation
  insightDocumentRefs InsightDocumentRef[]
  companyDocumentRefs CompanyDocumentRef[]
  actorDocumentRefs   ActorDocumentRef[]
  sourceCitations     SourceCitation[]

  @@index([category])
  @@index([country])
  @@index([documentType])
  @@index([tags], type: Gin)
}

model DocumentRef {
  id      String @id @default(cuid())
  fromId  String
  toId    String
  refType String // cites, references, supports, contradicts

  from Document @relation("refFrom", fields: [fromId], references: [id])
  to   Document @relation("refTo", fields: [toId], references: [id])

  @@unique([fromId, toId, refType])
}

// ─── Domain 2: Sources ──────────────────────────────────────────────

model SourceDoc {
  id          String    @id // src-1..src-70
  filename    String
  title       String?
  author      String?
  year        String? // can be number or string in source data
  sourceType  String
  description String
  relevance   String
  url         String?
  isDuplicate Boolean   @default(false)
  doi         String?
  publisher   String?
  accessedAt  DateTime?
  archivedUrl String?

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  sourceRefs      SourceRef[]
  insights        Insight[]        @relation("InsightSourceDoc")
  mediaEntries    MediaEntry[]
  sourceCitations SourceCitation[]

  @@index([sourceType])
}

model SourceCitation {
  id                 String             @id @default(cuid())
  sourceClass        SourceClass        @default(unknown)
  citationReadiness  CitationReadiness  @default(blocked_unsourced)
  verificationStatus VerificationStatus @default(needs_review)
  citationText       String
  title              String?
  publisher          String?
  author             String?
  year               Int?
  url                String?
  archivedUrl        String?
  localPath          String?
  fileHash           String?
  contentHash        String?
  hashAlgorithm      String             @default("sha256")
  pageRef            String?
  quote              String?
  accessedAt         DateTime?
  captureMethod      String             @default("manual")
  verifiedAt         DateTime?
  verifiedBy         String?
  confidence         Int?
  notes              String?
  documentId         String?
  sourceDocId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  document           Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceDoc          SourceDoc?      @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  fieldCitations     FieldCitation[]
  primaryForInsights  Insight[]   @relation("InsightPrimaryCitation")
  primaryForProducers Producer[]  @relation("ProducerPrimaryCitation")

  @@index([sourceClass])
  @@index([citationReadiness])
  @@index([verificationStatus])
  @@index([documentId])
  @@index([sourceDocId])
  @@index([url])
  @@index([localPath])
}

model FieldCitation {
  id         String   @id @default(cuid())
  citationId String
  entityType String
  entityId   String
  fieldPath  String?
  claimText  String?
  confidence Float?
  createdAt  DateTime @default(now())

  citation SourceCitation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([citationId, entityType, entityId, fieldPath])
  @@index([citationId])
  @@index([entityType, entityId])
  @@index([fieldPath])
}

model SourceRef {
  id          String  @id @default(cuid())
  sourceDocId String?
  label       String
  url         String?
  note        String?

  sourceDoc SourceDoc? @relation(fields: [sourceDocId], references: [id])
  insightId String?
  insight   Insight?   @relation(fields: [insightId], references: [id])
  meetingId String?
  meeting   Meeting?   @relation(fields: [meetingId], references: [id])

  @@index([sourceDocId])
  @@index([insightId])
}

// ─── Domain 3: Insights ─────────────────────────────────────────────

model Insight {
  id                String                   @id // ins-01..ins-42
  title             String
  description       String
  insightType       String
  source            String
  phaseId           String?
  tags              String[]
  url               String?
  sourceLabel       String?
  primaryCitationId String?
  date              String
  // search_vector: FTS-kolonne, se Document.search_vector
  search_vector     Unsupported("tsvector")?

  sourceDocLinks  SourceDoc[]          @relation("InsightSourceDoc")
  sourceRefs      SourceRef[]
  documentRefs    InsightDocumentRef[]
  primaryCitation SourceCitation?      @relation("InsightPrimaryCitation", fields: [primaryCitationId], references: [id], onDelete: SetNull)

  @@index([insightType])
  @@index([phaseId])
  @@index([primaryCitationId])
  @@index([tags], type: Gin)
}

model InsightDocumentRef {
  id         String @id @default(cuid())
  insightId  String
  documentId String
  relevance  String @default("related")

  insight  Insight  @relation(fields: [insightId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([insightId, documentId])
}

// ─── Domain 4: Theses ───────────────────────────────────────────────

model Thesis {
  id           String   @id // e.g. jacobsen-jansson-2022
  authors      String
  institution  String
  year         Int
  title        String
  titleNo      String?
  url          String
  synthesis    String
  keyFindings  String[]
  tags         String[]
  takeaways    String[]
  method       String?
  awardWinning Boolean  @default(false)
  degree       String   @default("master") // master | phd
  doi          String?
  isbn         String?
  publisher    String?
  accessDate   String?

  documentId    String?                  @unique
  document      Document?                @relation(fields: [documentId], references: [id])
  // search_vector: FTS-kolonne, se Document.search_vector
  search_vector Unsupported("tsvector")?

  @@index([institution])
  @@index([tags], type: Gin)
}

// ─── Domain 4b: Reports ─────────────────────────────────────────────

model Report {
  id                String   @id
  title             String
  fullTitle         String?
  author            String?
  institution       String?
  date              String?
  year              Int?
  sourceUrl         String?
  reportCategory    String
  country           String   @default("NO")
  keyFindings       String[]
  recommendations   String[]
  relevance         String
  tags              String[]
  doi               String?
  isbn              String?
  issn              String?
  publisher         String?
  provenanceType    String?
  supportingSources Json?

  documentId    String?                  @unique
  document      Document?                @relation(fields: [documentId], references: [id])
  // search_vector: FTS-kolonne, se Document.search_vector
  search_vector Unsupported("tsvector")?

  @@index([reportCategory])
  @@index([country])
  @@index([provenanceType])
  @@index([tags], type: Gin)
}

// ─── Domain 5: Companies ────────────────────────────────────────────

model Company {
  id                  String    @id @default(cuid())
  name                String
  orgNr               String    @unique
  legalForm           String?
  founded             Int?
  naceCode            String?
  naceDescription     String?
  country             String    @default("NO")
  hqAddress           String?
  hqCity              String?
  employees           Int?
  ownershipType       String? // family, cooperative, state, foreign, listed
  valueChainStage     String? // retail, processing, seafood, inputs, logistics
  metadata            Json?
  isResearchConstruct Boolean   @default(false)
  orgNrFormat         String    @default("bronnoysund")
  registrySource      String?
  registryVerifiedAt  DateTime?
  lastBrregRefreshAt  DateTime?

  financials   CompanyFinancial[]
  shareholders Shareholder[]
  boardMembers BoardMember[]
  subsidies    Subsidy[]
  documentRefs CompanyDocumentRef[]
  actor        Actor?

  parentOf          CompanyOwnership[]       @relation("ParentCompany")
  childOf           CompanyOwnership[]       @relation("ChildCompany")
  ownedProperties   CompanyProperty[]        @relation("PropertyOwner")
  tenantProperties  CompanyProperty[]        @relation("PropertyTenant")
  relationshipsFrom BusinessRelationship[]   @relation("RelationshipFrom")
  relationshipsTo   BusinessRelationship[]   @relation("RelationshipTo")
  aquacultureSites  AquacultureSite[]
  aquacultureApps   AquacultureApplication[]
  deliveriesFrom    DeliveryVolume[]         @relation("DeliverySupplier")
  deliveriesTo      DeliveryVolume[]         @relation("DeliveryBuyer")

  @@index([country])
  @@index([valueChainStage])
  @@index([isResearchConstruct])
  @@index([orgNrFormat])
}

model Producer {
  id                String           @id @default(cuid())
  orgNr             String           @unique
  name              String
  country           String           @default("NO")
  municipality      String?
  metadata          Json?
  primaryCitationId String?
  subsidies         Subsidy[]
  deliveries        DeliveryVolume[] @relation("DeliverySupplierProducer")
  primaryCitation   SourceCitation?  @relation("ProducerPrimaryCitation", fields: [primaryCitationId], references: [id], onDelete: SetNull)

  @@index([country])
  @@index([primaryCitationId])
}

model CompanyFinancial {
  id                 String    @id @default(cuid())
  companyId          String
  year               Int
  revenueNok         Decimal?  @db.Decimal(15, 2)
  operatingResult    Decimal?  @db.Decimal(15, 2)
  operatingMargin    Decimal?  @db.Decimal(5, 2)
  ebitda             Decimal?  @db.Decimal(15, 2)
  equityRatio        Decimal?  @db.Decimal(5, 2)
  groupEmployees     Int?
  source             String?
  fiscalYearLabel    String?
  fiscalPeriodStart  DateTime?
  fiscalPeriodEnd    DateTime?
  reportingCurrency  String?
  fxRateNokPerUnit   Decimal?  @db.Decimal(18, 8)
  fxRateSource       String?
  verificationStatus String?
  verifiedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, year])
  @@index([fiscalPeriodStart, fiscalPeriodEnd])
}

model Shareholder {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  ownershipPct       Decimal?  @db.Decimal(5, 2)
  shareholderType    String? // family, institutional, state, cooperative, foreign
  isControlling      Boolean   @default(false)
  source             String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verificationStatus String?
  sourceBasis        String?
  sourceRank         Int?
  sourceObservedAt   DateTime?
  sourceUpdatedAt    DateTime?
  confidence         Int?
  shareCount         BigInt?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, sourceBasis])
}

model BoardMember {
  id                 String    @id @default(cuid())
  companyId          String
  personName         String
  role               String // styreleder, nestleder, styremedlem, CEO, CFO
  personKey          String // normalized name for interlocking detection
  source             String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verificationStatus String?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([personKey])
}

model Subsidy {
  id                 String    @id @default(cuid())
  companyId          String?
  producerId         String?
  subsidyType        String
  scheme             String? // granular scheme within subsidyType (e.g. "arealtilskudd", "melkeproduksjon")
  project            String?
  amountNok          Decimal?  @db.Decimal(15, 2)
  year               Int?
  kommuneNr          String?
  source             String?
  verificationStatus String?
  verifiedAt         DateTime?

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producer Producer? @relation(fields: [producerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId])
  @@index([producerId])
  @@index([scheme])
  @@index([year])
}

model CompanyDocumentRef {
  id         String  @id @default(cuid())
  companyId  String
  documentId String
  context    String?

  company  Company  @relation(fields: [companyId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([companyId, documentId])
}

model Actor {
  id                 String    @id
  slug               String    @unique
  name               String
  actorType          String
  country            String    @default("NO")
  organizationType   String?
  roleSummary        String
  currentRelevance   String?
  website            String?
  currentStance      String?
  desiredStance      String?
  specificAsk        String?
  priorityTier       String?
  owner              String?
  nextStep           String?
  powerScore         Int?
  interestScore      Int?
  themeTags          String[]
  notes              String?
  metadata           Json?
  verificationStatus String?
  lastVerifiedAt     DateTime?

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id])

  contacts          ActorContact[]
  documentRefs      ActorDocumentRef[]
  relationshipsFrom ActorRelationship[] @relation("ActorRelationshipFrom")
  relationshipsTo   ActorRelationship[] @relation("ActorRelationshipTo")

  @@unique([country, name])
  @@index([actorType])
  @@index([country])
  @@index([priorityTier])
  @@index([currentStance])
  @@index([themeTags], type: Gin)
}

model ActorContact {
  id           String  @id @default(cuid())
  actorId      String
  name         String
  role         String?
  email        String?
  organization String?
  note         String?

  actor Actor @relation(fields: [actorId], references: [id])

  @@index([actorId])
}

model ActorDocumentRef {
  id         String  @id @default(cuid())
  actorId    String
  documentId String
  context    String?

  actor    Actor    @relation(fields: [actorId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([actorId, documentId])
  @@index([documentId])
}

model ActorRelationship {
  id           String  @id @default(cuid())
  fromActorId  String
  toActorId    String
  relationType String
  strength     String?
  note         String?
  source       String?
  sourceUrl    String?
  metadata     Json?
  verifiedAt   DateTime?

  fromActor Actor @relation("ActorRelationshipFrom", fields: [fromActorId], references: [id])
  toActor   Actor @relation("ActorRelationshipTo", fields: [toActorId], references: [id])

  @@unique([fromActorId, toActorId, relationType])
  @@index([fromActorId])
  @@index([toActorId])
  @@index([relationType])
}

// ─── Domain 5b: Corporate Structure & Relationships ────────────────

model CompanyOwnership {
  id              String    @id @default(cuid())
  parentCompanyId String
  childCompanyId  String
  ownershipPct    Float?
  ownershipType   String // subsidiary, joint-venture, minority-stake
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  source          String
  metadata        Json?

  parentCompany Company @relation("ParentCompany", fields: [parentCompanyId], references: [id])
  childCompany  Company @relation("ChildCompany", fields: [childCompanyId], references: [id])

  @@unique([parentCompanyId, childCompanyId])
  @@index([parentCompanyId])
  @@index([childCompanyId])
}

model CompanyProperty {
  id              String  @id @default(cuid())
  companyId       String
  propertyType    String // warehouse, retail, office, production, logistics
  address         String?
  municipality    String?
  county          String?
  country         String  @default("NO")
  lat             Float?
  lng             Float?
  sqMeters        Float?
  acquiredYear    Int?
  selfLeased      Boolean @default(false)
  tenantCompanyId String?
  source          String?
  metadata        Json?

  company       Company  @relation("PropertyOwner", fields: [companyId], references: [id])
  tenantCompany Company? @relation("PropertyTenant", fields: [tenantCompanyId], references: [id])

  @@index([companyId])
  @@index([tenantCompanyId])
  @@index([propertyType])
  @@index([selfLeased])
}

model BusinessRelationship {
  id                 String    @id @default(cuid())
  fromCompanyId      String
  toCompanyId        String
  relationshipType   String // supplier, buyer, distributor, franchisor, self-dealing, joint-venture
  description        String?
  sector             String?
  estimatedValue     Float?
  source             String?
  metadata           Json?
  verificationStatus String?
  verifiedAt         DateTime?

  fromCompany Company @relation("RelationshipFrom", fields: [fromCompanyId], references: [id])
  toCompany   Company @relation("RelationshipTo", fields: [toCompanyId], references: [id])

  @@unique([fromCompanyId, toCompanyId, relationshipType])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([relationshipType])
}

model PersonProfile {
  id             String    @id @default(cuid())
  name           String
  personKey      String    @unique
  roles          Json[] // {companyId, companyName, role, fromYear, toYear}
  biography      String?
  linkedInUrl    String?
  photoUrl       String?
  affiliations   String[]
  tags           String[]
  metadata       Json?
  lastVerifiedAt DateTime?

  @@index([personKey])
  @@index([tags], type: Gin)
}

// ─── Domain 6: Project Management ───────────────────────────────────

model Phase {
  id     String   @id // fase-1..fase-4
  name   String
  weeks  String
  items  String[]
  status String   @default("ikke-startet")
}

model ProjectTask {
  id       String  @id // task-1..task-18
  title    String
  source   String
  status   String  @default("ikke-startet")
  priority String  @default("middels")
  phaseId  String?
}

model TeamMember {
  id           String @id // gabriel, cathrine, etc.
  name         String
  role         String
  title        String
  organization String
}

model Application {
  id       String   @id // ni-2024, nch-2025, oslo-2025
  title    String
  year     Int
  status   String
  budget   String
  partners String[]
  phases   Json // ApplicationPhase[]
  scope    String
}

model Deliverable {
  id       String @id
  name     String
  deadline String
  status   String @default("ikke-startet")
}

model KPI {
  id          String  @id
  name        String
  description String
  current     String?
  target      String?
}

model TenStep {
  step        Int     @id
  theme       String
  output      String
  status      String  @default("ikke-startet")
  methodology String?
  description String?
}

model EvidenceDoc {
  id     String @id
  name   String
  status String @default("ikke-startet")
}

// ─── Domain 7: Meetings & Communications ────────────────────────────

model Meeting {
  id           String      @id // meeting-1, meeting-2, etc.
  date         String
  title        String
  participants String[]
  source       String
  summary      String
  keyDecisions String[]
  actionItems  String[]
  keyInsights  String[]
  sourceRefs   SourceRef[]
}

model Communication {
  id         String   @id
  title      String
  summary    String
  commType   String
  sender     String   @map("from")
  recipients String[] @map("to")
  date       String
  tags       String[]

  @@index([tags], type: Gin)
}

// ─── Domain 8: Research Prompts ─────────────────────────────────────

model ResearchPrompt {
  id             String @id
  category       String
  title          String
  prompt         String
  model          String
  expectedOutput String
  language       String @default("no")
  status         String @default("aktiv")

  @@index([category])
  @@index([status])
}

// ─── Domain 9: Market Data ──────────────────────────────────────────

model CountryMetric {
  id         String  @id @default(cuid())
  country    String // DB-canonical uppercase ISO: NO, SE, DK, FI, IS, Nordic, EU
  metricType String // selfSufficiency, margin, marketShare
  category   String // e.g. "Melk", "Kjøtt", "NorgesGruppen"
  value      Decimal @db.Decimal(10, 2)
  unit       String? // %, NOK, etc.
  year       String
  source     String
  subtitle   String?
  metadata   Json?

  @@unique([country, metricType, category, year])
  @@index([country, metricType])
}

// ─── Domain 9b: Aquaculture & Agricultural Operations ──────────────

model AquacultureSite {
  id             String  @id @default(cuid())
  localityNumber String  @unique
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])

  siteName       String?
  municipality   String?
  municipalityNo String?
  county         String?
  country        String  @default("NO")
  lat            Float?
  lng            Float?

  licenseStatus     String? // aktiv, paused, revoked
  placement         String? // SJØ, HAV, LAND
  waterType         String? // seawater, freshwater
  capacityTonnes    Float?
  capacityUnit      String?  @default("MTB")
  species           String[]
  productionTypes   String[]
  licenseIssuedYear Int?

  source    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthObservations FishHealthObservation[]

  @@index([companyId])
  @@index([licenseStatus])
  @@index([municipalityNo])
}

model FishHealthObservation {
  id     String          @id @default(cuid())
  siteId String
  site   AquacultureSite @relation(fields: [siteId], references: [id])

  year            Int
  week            Int
  observationDate DateTime?

  avgAdultFemaleLice     Float?
  avgMobileLice          Float?
  avgStationaryLice      Float?
  seaTemperature         Float?
  isFallow               Boolean @default(false)
  hasReportedLice        Boolean @default(false)
  hasBathTreatment       Boolean @default(false)
  hasInFeedTreatment     Boolean @default(false)
  hasMechanicalRemoval   Boolean @default(false)
  hasCleanerFishDeployed Boolean @default(false)

  diseaseType   String?
  diseaseStatus String?
  diseaseNote   String?

  source    String   @default("BarentsWatch")
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([siteId, year, week, diseaseType])
  @@index([siteId])
  @@index([year, week])
  @@index([diseaseType])
}

model AquacultureApplication {
  id             String   @id @default(cuid())
  applicationNo  String   @unique
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  applicantOrgNr String
  applicantName  String?

  applicationType String?
  title           String?
  status          String? // SUBMITTED, PROCESSED, WITHDRAWN, RETURNED, OTHER
  result          String? // GRANTED, DENIED, NO_DECISION, FOLLOWS_REGULATIONS

  submittedAt          DateTime?
  createdAt            DateTime?
  evaluationFinishedAt DateTime?
  withdrawnAt          DateTime?

  source    String   @default("Fiskeridirektoratet")
  metadata  Json?
  fetchedAt DateTime @default(now())

  @@index([companyId])
  @@index([applicantOrgNr])
  @@index([status])
}

model DeliveryVolume {
  id                 String   @id @default(cuid())
  supplierId         String?
  supplierProducerId String?
  supplier           Company? @relation("DeliverySupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierProducer   Producer? @relation("DeliverySupplierProducer", fields: [supplierProducerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierOrgNr      String
  buyerId            String?
  buyer              Company? @relation("DeliveryBuyer", fields: [buyerId], references: [id])
  buyerName          String?

  commodity String // melk-ku, melk-geit, egg, korn, slakt-storfe, slakt-svin, slakt-saue, slakt-fjorfe
  year      Int
  quantity  Float
  unit      String // liter, kg, tonn
  kommuneNr String?

  source    String   @default("Landbruksdirektoratet")
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([supplierOrgNr, commodity, year])
  @@index([supplierId])
  @@index([supplierProducerId])
  @@index([buyerId])
  @@index([commodity, year])
}

// ─── Domain 10: Media Landscape ─────────────────────────────────────

model MediaTheme {
  id          String @id // beredskap, prispress, etc.
  name        String
  description String
  sources     Json? // SourceRef[]
}

model MediaTimelineEntry {
  id        String @id @default(cuid())
  year      Int
  intensity Int
  label     String
  note      String
  sources   Json? // SourceRef[]

  @@unique([year])
}

model MediaCountryProfile {
  id                String @id // no, se, dk, fi, is
  name              String
  iso               String
  dominantNarrative String
  summary           String
  strongestPeriod   String
  keyQuestion       String
  yearlySignal      Int[]
  focusLevels       Json // Record<MediaThemeId, MediaFocusLevel>
  triggerMoments    Json // MediaTriggerMoment[]
  sources           Json? // SourceRef[]
}

// ─── Domain 11: Media Evidence Corpus ───────────────────────────────

model MediaOutlet {
  id         String  @id
  name       String
  country    String
  outletType String
  language   String?
  url        String?
  notes      String?

  entries MediaEntry[]

  @@index([country])
  @@index([outletType])
}

model MediaEntry {
  id                String   @id
  outletId          String
  country           String
  publishedYear     Int
  publishedMonth    Int?
  publishedDay      Int?
  datePrecision     String
  title             String
  summary           String
  url               String?  @unique
  recordType        String
  verificationLevel String
  triggerLabel      String?
  sourceDocId       String?
  sourceRefs        Json? // SourceRef[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  outlet    MediaOutlet        @relation(fields: [outletId], references: [id])
  sourceDoc SourceDoc?         @relation(fields: [sourceDocId], references: [id])
  codings   MediaEntryCoding[]

  @@index([country, publishedYear])
  @@index([recordType])
  @@index([verificationLevel])
  @@index([sourceDocId])
}

model MediaEntryCoding {
  id              String   @id @default(cuid())
  entryId         String
  country         String
  primaryTheme    String
  secondaryThemes String[]
  tone            String
  frame           String
  geography       String
  actorTargets    String[]
  confidence      Int
  triggerLabel    String?
  evidenceNote    String?
  codedBy         String
  createdAt       DateTime @default(now())

  entry MediaEntry @relation(fields: [entryId], references: [id])

  @@unique([entryId, primaryTheme, tone, frame])
  @@index([entryId])
  @@index([country, primaryTheme])
  @@index([tone])
  @@index([frame])
}
