generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm(map: "pg_trgm"), vector(map: "vector")]
}

enum SourceClass {
  primary
  secondary
  dataset
  internal_primary
  internal_synthesis
  media
  unknown
  synthesis
  internal_construct
  registry_snapshot
  legacy_unsourced
}

enum VerificationStatus {
  verified
  partially_verified
  needs_review
  failed
  unverified
  machine_verified
  human_verified
  disputed
  rejected
}

enum CitationReadiness {
  citable_external
  citable_with_note
  internal_context
  blocked_unsourced
}

enum EvidenceAppraisalStatus {
  draft
  reviewed
  excluded_not_applicable
}

enum EvidenceAppraisalBasis {
  peer_reviewed
  formally_examined_thesis
  official_primary
  grey_literature
  internal_material
  other
  unclear
}

enum EvidenceStudyDesign {
  experimental
  quasi_experimental
  observational
  qualitative
  mixed_methods
  evidence_synthesis
  modelling
  economic_analysis
  legal_policy_analysis
  descriptive_document
  other
  unclear
  not_applicable
}

enum EvidenceApplicability {
  direct
  indirect
  limited
  unclear
  not_applicable
}

enum EvidenceLimitationsStatus {
  identified
  none_identified
  unclear
  not_applicable
}

enum EvidenceRiskOfBias {
  low
  some_concerns
  high
  critical
  unclear
  not_applicable
}

enum EvidenceReviewMethod {
  full_text
  partial_text
  metadata_only
}

enum CandidateContentUnitType {
  pdf_page
  document_section
  web_section
  slide
  sheet_range
  transcript_segment
  database_record
  dataset_slice
  media_segment
}

enum CandidateIdentityConfidence {
  exact
  provisional
  unresolved
}

enum CandidateEvidenceLevel {
  exact_locator
  partial_locator
  no_locator
}

enum CandidateMachineUse {
  candidate_only
  reusable_for_ai_context
  quarantined
}

enum CandidateRunEventType {
  queued
  started
  checkpoint
  candidate_completed
  partial_completed
  failed
  blocked_input
  quarantined
  superseded
}

enum CandidateAssertionType {
  claim
  classification
  entity_link
  relationship
  quantitative_observation
  coverage_signal
  gap
  contradiction
  source_role_suggestion
}

enum CandidateEvidenceRelation {
  supports
  contradicts
  contextualizes
}

enum CandidatePromotionState {
  candidate
  internal_curated
  external_eligible
  published
  revoked
}

enum CandidateReviewDecision {
  accepted
  accepted_with_edits
  rejected
  deferred
  rerun_requested
}

// ─── Domain 1: Documents ────────────────────────────────────────────

model Document {
  id            String                       @id @default(cuid())
  slug          String                       @unique
  filePath      String?                      @unique
  title         String
  author        String?
  year          Int?
  documentType  String?
  category      String?
  subcategory   String?
  country       String?
  content       String
  summary       String?
  url           String?
  accessedAt    DateTime?
  archivedUrl   String?
  wordCount     Int                          @default(0)
  tags          String[]
  metadata      Json?
  embedding     Unsupported("vector(1536)")?
  // search_vector: FTS-kolonne lagt til via raw SQL (scripts/add-postgres-fts.sql)
  // GENERATED ALWAYS AS (...) STORED — Prisma kan ikke uttrykke dette, men
  // erklæring her hindrer `prisma db push` fra å droppe kolonnen.
  search_vector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refsFrom               DocumentRef[]           @relation("refFrom")
  refsTo                 DocumentRef[]           @relation("refTo")
  sourceDoc              SourceDoc?              @relation
  thesis                 Thesis?                 @relation
  report                 Report?                 @relation
  insightDocumentRefs    InsightDocumentRef[]
  companyDocumentRefs    CompanyDocumentRef[]
  actorDocumentRefs      ActorDocumentRef[]
  sourceCitations        SourceCitation[]
  libraryAnalysisRecords LibraryAnalysisRecord[]
  libraryAnalysisRuns    LibraryAnalysisRun[]

  @@index([category])
  @@index([country])
  @@index([documentType])
  @@index([tags], type: Gin)
}

model DocumentRef {
  id      String @id @default(cuid())
  fromId  String
  toId    String
  refType String // cites, references, supports, contradicts

  from Document @relation("refFrom", fields: [fromId], references: [id])
  to   Document @relation("refTo", fields: [toId], references: [id])

  @@unique([fromId, toId, refType])
}

// ─── Domain 2: Sources ──────────────────────────────────────────────

model SourceDoc {
  id             String    @id // src-1..src-70
  filename       String
  title          String?
  author         String?
  year           String? // can be number or string in source data
  sourceType     String
  description    String
  relevance      String
  url            String?
  isDuplicate    Boolean   @default(false)
  doi            String?
  publisher      String?
  provenanceType String    @default("unknown")
  accessedAt     DateTime?
  archivedUrl    String?

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  sourceRefs             SourceRef[]
  insights               Insight[]               @relation("InsightSourceDoc")
  mediaEntries           MediaEntry[]
  sourceCitations        SourceCitation[]
  libraryAnalysisRecords LibraryAnalysisRecord[]
  libraryAnalysisRuns    LibraryAnalysisRun[]
  evidenceAppraisal      EvidenceAppraisal?

  @@index([sourceType])
  @@index([provenanceType])
}

model SourceCitation {
  id                 String             @id @default(cuid())
  sourceClass        SourceClass        @default(unknown)
  citationReadiness  CitationReadiness  @default(blocked_unsourced)
  verificationStatus VerificationStatus @default(needs_review)
  citationText       String
  title              String?
  publisher          String?
  author             String?
  year               Int?
  url                String?
  archivedUrl        String?
  localPath          String?
  fileHash           String?
  contentHash        String?
  hashAlgorithm      String             @default("sha256")
  pageRef            String?
  quote              String?
  accessedAt         DateTime?
  captureMethod      String             @default("manual")
  verifiedAt         DateTime?
  verifiedBy         String?
  confidence         Int?
  notes              String?
  documentId         String?
  sourceDocId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  document                 Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceDoc                SourceDoc?          @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  fieldCitations           FieldCitation[]
  primaryForInsights       Insight[]           @relation("InsightPrimaryCitation")
  primaryForProducers      Producer[]          @relation("ProducerPrimaryCitation")
  reviewBasisForAppraisals EvidenceAppraisal[] @relation("EvidenceAppraisalReviewBasis")

  @@index([sourceClass])
  @@index([citationReadiness])
  @@index([verificationStatus])
  @@index([documentId])
  @@index([sourceDocId])
  @@index([url])
  @@index([localPath])
}

model FieldCitation {
  id         String   @id @default(cuid())
  citationId String
  entityType String
  entityId   String
  fieldPath  String?
  claimText  String?
  confidence Float?
  createdAt  DateTime @default(now())

  citation SourceCitation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([citationId, entityType, entityId, fieldPath])
  @@index([citationId])
  @@index([entityType, entityId])
  @@index([fieldPath])
}

// Stable database lineage and append-only receipts for controlled mutations.
// Database-side constraints and triggers make both models fail-closed even
// when a writer bypasses Prisma.
model DatabaseIdentity {
  key            String                    @id
  identityUuid   String                    @unique @db.Uuid
  createdAt      DateTime                  @default(now())
  mutationAudits ControlledMutationAudit[]
}

model ControlledMutationAudit {
  id                      String   @id @default(cuid())
  operationKey            String   @unique
  contractScope           String
  contractSha256          String
  planSha256              String
  beforeSnapshotSha256    String
  afterSnapshotSha256     String
  dependencyStateSha256   String
  databaseIdentityUuid    String   @db.Uuid
  targetFingerprintSha256 String
  backupSha256            String
  backupMetadataSha256    String
  restoreReceiptSha256    String
  operatorId              String
  authorizationRef        String
  databaseRole            String
  mutationSummary         Json
  recordedAt              DateTime @default(now())

  databaseIdentity DatabaseIdentity @relation(fields: [databaseIdentityUuid], references: [identityUuid], onDelete: Restrict, onUpdate: Restrict)

  @@index([contractScope])
  @@index([recordedAt])
}

model CandidateContentUnit {
  id                 String                      @id @default(cuid())
  sourceKind         String
  sourceKey          String
  sourceVersionHash  String
  unitType           CandidateContentUnitType
  ordinal            Int
  locator            String
  locatorHash        String
  contentHash        String
  hashAlgorithm      String                      @default("sha256")
  identityConfidence CandidateIdentityConfidence
  createdAt          DateTime                    @default(now())

  runInputs     CandidateAnalysisRunInput[]
  evidenceLinks CandidateEvidenceLink[]

  @@unique([sourceKind, sourceKey, sourceVersionHash, unitType, ordinal])
  @@index([sourceKey])
  @@index([contentHash])
}

model CandidateAnalysisRun {
  id                String   @id @default(cuid())
  scopeHash         String
  workflowId        String
  workflowVersion   String
  workflowPath      String
  workflowHash      String
  promptId          String
  promptVersion     String
  promptPath        String
  modelProvider     String
  modelName         String
  modelVersion      String
  promptHash        String
  config            Json
  configHash        String
  inputEnvelopeHash String
  purpose           String
  outputProfile     String
  workerId          String
  idempotencyKey    String   @unique
  attempt           Int
  predecessorRunId  String?
  createdAt         DateTime @default(now())

  predecessorRun          CandidateAnalysisRun?             @relation("CandidateRunPredecessor", fields: [predecessorRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  successorRuns           CandidateAnalysisRun[]            @relation("CandidateRunPredecessor")
  inputs                  CandidateAnalysisRunInput[]
  eventsByScope           CandidateAnalysisRunEvent[]
  artifacts               CandidateAnalysisArtifact[]
  assertions              CandidateAssertion[]
  reconciliationSnapshots CandidateReconciliationSnapshot[]

  @@unique([id, scopeHash])
  @@index([workflowId, workflowVersion])
  @@index([createdAt])
}

model CandidateAnalysisRunInput {
  id            String   @id @default(cuid())
  runId         String
  contentUnitId String
  position      Int
  inputHash     String
  createdAt     DateTime @default(now())

  run         CandidateAnalysisRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentUnit CandidateContentUnit @relation(fields: [contentUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, position])
  @@unique([runId, contentUnitId])
}

model CandidateAnalysisRunEvent {
  id                       String                @id @default(cuid())
  runId                    String
  scopeHash                String
  sequence                 Int
  eventType                CandidateRunEventType
  payload                  Json?
  eventHash                String
  supersededEventId        String?
  supersededEventHash      String?
  supersededEventScopeHash String?
  recordedAt               DateTime              @default(now())

  runByScope        CandidateAnalysisRun        @relation(fields: [runId, scopeHash], references: [id, scopeHash], onDelete: Restrict, onUpdate: Restrict, map: "CandidateRunEvent_run_scope_fkey")
  supersededEvent   CandidateAnalysisRunEvent?  @relation("CandidateRunEventSupersession", fields: [supersededEventId, supersededEventHash, runId, supersededEventScopeHash], references: [id, eventHash, runId, scopeHash], onDelete: Restrict, onUpdate: Restrict, map: "CandidateRunEvent_supersession_hash_scope_fkey")
  supersedingEvents CandidateAnalysisRunEvent[] @relation("CandidateRunEventSupersession")

  @@unique([id, eventHash, runId, scopeHash])
  @@unique([runId, sequence])
  @@unique([runId, eventHash])
}

model CandidateAnalysisArtifact {
  id            String   @id @default(cuid())
  runId         String
  artifactType  String
  schemaVersion String
  payload       Json
  payloadHash   String
  createdAt     DateTime @default(now())

  run CandidateAnalysisRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, payloadHash])
}

model CandidateAssertion {
  id                             String                      @id @default(cuid())
  runId                          String
  assertionType                  CandidateAssertionType
  schemaVersion                  String
  payload                        Json
  payloadHash                    String
  confidence                     Float?
  machineUse                     CandidateMachineUse
  identityConfidence             CandidateIdentityConfidence
  evidenceLevel                  CandidateEvidenceLevel
  limitations                    String[]
  scopeKey                       String
  scopeHash                      String
  supersededAssertionId          String?
  supersededAssertionPayloadHash String?
  createdAt                      DateTime                    @default(now())

  run                   CandidateAnalysisRun           @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededAssertion   CandidateAssertion?            @relation("CandidateAssertionSupersession", fields: [supersededAssertionId, supersededAssertionPayloadHash, scopeHash], references: [id, payloadHash, scopeHash], onDelete: Restrict, onUpdate: Restrict, map: "CandidateAssertion_supersession_hash_scope_fkey")
  supersedingAssertions CandidateAssertion[]           @relation("CandidateAssertionSupersession")
  evidenceLinks         CandidateEvidenceLink[]
  dependencies          CandidateDependency[]          @relation("CandidateAssertionDependencies")
  upstreamDependencies  CandidateDependency[]          @relation("CandidateAssertionUpstreamDependencies")
  humanReviewDecisions  CandidateHumanReviewDecision[]
  promotionDecisions    CandidatePromotionDecision[]

  @@unique([id, payloadHash])
  @@unique([id, payloadHash, scopeHash])
  @@unique([runId, payloadHash])
  @@index([assertionType])
  @@index([machineUse])
  @@index([identityConfidence])
  @@index([evidenceLevel])
}

model CandidateEvidenceLink {
  id            String                    @id @default(cuid())
  assertionId   String
  contentUnitId String
  relation      CandidateEvidenceRelation
  locator       String
  locatorHash   String
  excerptHash   String?
  createdAt     DateTime                  @default(now())

  assertion   CandidateAssertion   @relation(fields: [assertionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentUnit CandidateContentUnit @relation(fields: [contentUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assertionId, contentUnitId, relation, locatorHash])
}

model CandidateDependency {
  id                   String   @id @default(cuid())
  assertionId          String
  upstreamAssertionId  String
  relation             String
  inheritedLimitations String[]
  createdAt            DateTime @default(now())

  assertion         CandidateAssertion @relation("CandidateAssertionDependencies", fields: [assertionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  upstreamAssertion CandidateAssertion @relation("CandidateAssertionUpstreamDependencies", fields: [upstreamAssertionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assertionId, upstreamAssertionId, relation])
}

model CandidateReconciliationSnapshot {
  id            String   @id @default(cuid())
  runId         String
  scope         Json
  scopeHash     String
  payload       Json
  payloadHash   String
  conflictCount Int
  createdAt     DateTime @default(now())

  run CandidateAnalysisRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, payloadHash])
}

model CandidateHumanReviewDecision {
  id                     String                  @id @default(cuid())
  assertionId            String
  decision               CandidateReviewDecision
  reviewProfile          String
  reviewProfileHash      String
  reviewer               String
  authority              String
  assertionPayloadHash   String
  sourceContentSetHash   String
  evidenceSetHash        String
  decisionHash           String
  limitations            String[]
  editedPayload          Json?
  editedPayloadHash      String?
  supersededDecisionId   String?
  supersededDecisionHash String?
  createdAt              DateTime                @default(now())

  assertion            CandidateAssertion             @relation(fields: [assertionId, assertionPayloadHash], references: [id, payloadHash], onDelete: Restrict, onUpdate: Restrict)
  supersededDecision   CandidateHumanReviewDecision?  @relation("CandidateHumanReviewSupersession", fields: [supersededDecisionId, supersededDecisionHash, assertionId, reviewProfile, reviewProfileHash], references: [id, decisionHash, assertionId, reviewProfile, reviewProfileHash], onDelete: Restrict, onUpdate: Restrict, map: "CandidateReview_supersession_receipt_scope_fkey")
  supersedingDecisions CandidateHumanReviewDecision[] @relation("CandidateHumanReviewSupersession")
  promotionDecisions   CandidatePromotionDecision[]

  @@unique([id, assertionId])
  @@unique([id, decisionHash, assertionId])
  @@unique([id, decisionHash, assertionId, reviewProfile, reviewProfileHash])
  @@index([assertionId])
  @@index([decision])
  @@index([reviewProfile])
}

model CandidatePromotionDecision {
  id                     String                  @id @default(cuid())
  assertionId            String
  assertionPayloadHash   String
  reviewDecisionId       String
  reviewDecisionHash     String
  targetProfile          String
  targetProfileHash      String
  state                  CandidatePromotionState
  policyVersion          String
  policyHash             String
  preconditionsHash      String
  targetRefs             Json
  targetSetHash          String
  result                 Json
  resultHash             String
  decisionHash           String
  operator               String
  authority              String
  supersededDecisionId   String?
  supersededDecisionHash String?
  supersededPolicyHash   String?
  createdAt              DateTime                @default(now())

  assertion            CandidateAssertion           @relation(fields: [assertionId, assertionPayloadHash], references: [id, payloadHash], onDelete: Restrict, onUpdate: Restrict)
  reviewDecision       CandidateHumanReviewDecision @relation(fields: [reviewDecisionId, reviewDecisionHash, assertionId], references: [id, decisionHash, assertionId], onDelete: Restrict, onUpdate: Restrict, map: "CandidatePromotion_review_receipt_fkey")
  supersededDecision   CandidatePromotionDecision?  @relation("CandidatePromotionSupersession", fields: [supersededDecisionId, supersededDecisionHash, assertionId, targetProfile, targetProfileHash, supersededPolicyHash], references: [id, decisionHash, assertionId, targetProfile, targetProfileHash, policyHash], onDelete: Restrict, onUpdate: Restrict, map: "CandidatePromotion_supersession_receipt_scope_fkey")
  supersedingDecisions CandidatePromotionDecision[] @relation("CandidatePromotionSupersession")

  @@unique([id, decisionHash, assertionId, targetProfile, targetProfileHash, policyHash])
  @@index([assertionId])
  @@index([targetProfile, state])
}

model LibraryAnalysisRecord {
  id                  String    @id @default(cuid())
  sourceKind          String
  sourceKey           String
  documentId          String?
  sourceDocId         String?
  canonicalPath       String?
  title               String
  status              String    @default("not_started")
  usageRule           String    @default("internal_background")
  reviewStatus        String    @default("not_reviewed")
  citationReadiness   String?
  analysisTier        String    @default("triage_card")
  aiCard              Json?
  aiSummary           String?
  keyFindings         String[]
  claimCandidates     Json?
  projectImplications String[]
  gaps                Json?
  controlLinks        Json?
  riskFlags           String[]
  contentHash         String?
  wordCount           Int       @default(0)
  processedAt         DateTime?
  reviewedAt          DateTime?
  reviewer            String?
  currentRunId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  document   Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceDoc  SourceDoc?          @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  currentRun LibraryAnalysisRun? @relation(fields: [currentRunId], references: [id], onDelete: SetNull)

  @@unique([sourceKind, sourceKey])
  @@index([status])
  @@index([usageRule])
  @@index([reviewStatus])
  @@index([documentId])
  @@index([sourceDocId])
  @@index([canonicalPath])
  @@index([currentRunId])
}

model LibraryAnalysisRun {
  id                  String   @id @default(cuid())
  sourceKind          String
  sourceKey           String
  documentId          String?
  sourceDocId         String?
  canonicalPath       String?
  title               String
  runId               String
  aiModel             String
  promptVersion       String
  analysisTier        String   @default("triage_card")
  aiCard              Json?
  aiSummary           String?
  keyFindings         String[]
  claimCandidates     Json?
  projectImplications String[]
  gaps                Json?
  controlLinks        Json?
  riskFlags           String[]
  contentHash         String?
  payloadHash         String
  wordCount           Int      @default(0)
  createdAt           DateTime @default(now())

  document          Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceDoc         SourceDoc?              @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  currentForRecords LibraryAnalysisRecord[]

  @@unique([sourceKind, sourceKey, runId])
  @@index([sourceKind, sourceKey])
  @@index([runId])
  @@index([documentId])
  @@index([sourceDocId])
  @@index([createdAt])
}

model SourceRef {
  id          String  @id @default(cuid())
  sourceDocId String?
  label       String
  url         String?
  note        String?

  sourceDoc SourceDoc? @relation(fields: [sourceDocId], references: [id])
  insightId String?
  insight   Insight?   @relation(fields: [insightId], references: [id])
  meetingId String?
  meeting   Meeting?   @relation(fields: [meetingId], references: [id])

  @@index([sourceDocId])
  @@index([insightId])
}

// ─── Domain 2b: Food TG mandate board ───────────────────────────────

model ClaimBoardEntry {
  id              String   @id
  claimId         String
  track           String
  title           String
  strength        String
  status          String
  nextAction      String
  useNow          String
  needs           String
  sourcePath      String
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([claimId])
  @@index([track])
  @@index([status])
}

model OpportunityEntry {
  id              String   @id
  rank            Int      @unique
  title           String
  track           String
  role            String
  statuses        String[]
  whyNow          String
  canSay          String
  cannotSay       String
  validationNeed  String
  stopSignal      String
  nextAction      String
  claimIds        String[]
  evidenceIds     String[]
  sourceIds       String[]
  sourcePath      String
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([rank])
  @@index([track])
}

model FoodTgBoardLedger {
  id          String   @id @default(cuid())
  entryType   String
  entryId     String
  contentHash String
  snapshot    Json
  sourcePath  String
  importedAt  DateTime @default(now())

  @@unique([entryType, entryId, contentHash])
  @@index([entryType, entryId])
}

// ─── Domain 3: Insights ─────────────────────────────────────────────

model Insight {
  id                String                   @id // ins-01..ins-42
  title             String
  description       String
  insightType       String
  source            String
  phaseId           String?
  tags              String[]
  url               String?
  sourceLabel       String?
  primaryCitationId String?
  date              String
  // search_vector: FTS-kolonne, se Document.search_vector
  search_vector     Unsupported("tsvector")?

  sourceDocLinks  SourceDoc[]          @relation("InsightSourceDoc")
  sourceRefs      SourceRef[]
  documentRefs    InsightDocumentRef[]
  primaryCitation SourceCitation?      @relation("InsightPrimaryCitation", fields: [primaryCitationId], references: [id], onDelete: SetNull)

  @@index([insightType])
  @@index([phaseId])
  @@index([primaryCitationId])
  @@index([tags], type: Gin)
}

model InsightDocumentRef {
  id         String @id @default(cuid())
  insightId  String
  documentId String
  relevance  String @default("related")

  insight  Insight  @relation(fields: [insightId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([insightId, documentId])
}

// ─── Domain 4: Theses ───────────────────────────────────────────────

model Thesis {
  id           String   @id // e.g. jacobsen-jansson-2022
  authors      String
  institution  String
  year         Int
  title        String
  titleNo      String?
  url          String
  synthesis    String
  keyFindings  String[]
  tags         String[]
  takeaways    String[]
  method       String?
  awardWinning Boolean  @default(false)
  degree       String   @default("master") // master | phd
  doi          String?
  isbn         String?
  publisher    String?
  accessDate   String?

  documentId        String?                  @unique
  document          Document?                @relation(fields: [documentId], references: [id])
  evidenceAppraisal EvidenceAppraisal?
  // search_vector: FTS-kolonne, se Document.search_vector
  search_vector     Unsupported("tsvector")?

  @@index([institution])
  @@index([tags], type: Gin)
}

// ─── Domain 4b: Reports ─────────────────────────────────────────────

model Report {
  id                String    @id
  title             String
  fullTitle         String?
  author            String?
  institution       String?
  date              String?
  year              Int?
  sourceUrl         String?
  reportCategory    String
  country           String    @default("NO")
  keyFindings       String[]
  recommendations   String[]
  relevance         String
  tags              String[]
  doi               String?
  isbn              String?
  issn              String?
  publisher         String?
  provenanceType    String?
  supportingSources Json?
  accessedAt        DateTime?

  documentId        String?                  @unique
  document          Document?                @relation(fields: [documentId], references: [id])
  evidenceAppraisal EvidenceAppraisal?
  // search_vector: FTS-kolonne, se Document.search_vector
