  deliveriesTo      DeliveryVolume[]         @relation("DeliveryBuyer")

  @@index([country])
  @@index([valueChainStage])
  @@index([isResearchConstruct])
  @@index([orgNrFormat])
}

model Producer {
  id                String           @id @default(cuid())
  orgNr             String           @unique
  name              String
  country           String           @default("NO")
  municipality      String?
  metadata          Json?
  primaryCitationId String?
  subsidies         Subsidy[]
  deliveries        DeliveryVolume[] @relation("DeliverySupplierProducer")
  primaryCitation   SourceCitation?  @relation("ProducerPrimaryCitation", fields: [primaryCitationId], references: [id], onDelete: SetNull)

  @@index([country])
  @@index([primaryCitationId])
}

model CompanyFinancial {
  id                 String    @id @default(cuid())
  companyId          String
  year               Int
  /// ENHET: rå NOK (kroner) — ikke MNOK, ikke tNOK. Gjelder også
  /// `operatingResult` og `ebitda`. NorgesGruppen 2024 = 118000000000.
  ///
  /// Korpuset lå tidligere i to enheter samtidig: registerimportene skrev rå
  /// NOK, seed-importene MNOK. All sammenligning på tvers av selskaper var
  /// dermed feil med faktor 10^6 for en delmengde. Normalisert av
  /// `scripts/normalize-financial-units.ts`, som også forklarer hvorfor
  /// enheten må avgjøres av kilde og ikke av størrelsesorden: rå-NOK-rader
  /// går helt ned i 20 og 0 kroner.
  ///
  /// Nye importstier MÅ skrive rå NOK. Har du tall i MNOK, gang med
  /// 1_000_000 ved skriving, slik tre-importene gjør.
  revenueNok         Decimal?  @db.Decimal(15, 2)
  /// Rå NOK, samme enhet som `revenueNok`.
  operatingResult    Decimal?  @db.Decimal(15, 2)
  /// Prosent, ikke beløp — røres ikke av enhetsnormaliseringen.
  operatingMargin    Decimal?  @db.Decimal(5, 2)
  /// Rå NOK, samme enhet som `revenueNok`.
  ebitda             Decimal?  @db.Decimal(15, 2)
  /// Prosent, ikke beløp — røres ikke av enhetsnormaliseringen.
  equityRatio        Decimal?  @db.Decimal(5, 2)
  groupEmployees     Int?
  source             String?
  fiscalYearLabel    String?
  fiscalPeriodStart  DateTime?
  fiscalPeriodEnd    DateTime?
  reportingCurrency  String?
  fxRateNokPerUnit   Decimal?  @db.Decimal(18, 8)
  fxRateSource       String?
  verificationStatus String?
  verifiedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, year])
  @@index([fiscalPeriodStart, fiscalPeriodEnd])
}

model Shareholder {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  ownershipPct       Decimal?  @db.Decimal(5, 2)
  shareholderType    String? // family, institutional, state, cooperative, foreign
  isControlling      Boolean   @default(false)
  source             String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verificationStatus String?
  sourceBasis        String?
  sourceRank         Int?
  sourceObservedAt   DateTime?
  sourceUpdatedAt    DateTime?
  confidence         Int?
  shareCount         BigInt?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, sourceBasis])
}

model BoardMember {
  id                 String    @id @default(cuid())
  companyId          String
  personName         String
  role               String // styreleder, nestleder, styremedlem, CEO, CFO
  personKey          String // normalized name for interlocking detection
  source             String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verificationStatus String?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([personKey])
}

model Subsidy {
  id                 String    @id @default(cuid())
  companyId          String?
  producerId         String?
  subsidyType        String
  scheme             String? // granular scheme within subsidyType (e.g. "arealtilskudd", "melkeproduksjon")
  project            String?
  amountNok          Decimal?  @db.Decimal(15, 2)
  year               Int?
  kommuneNr          String?
  source             String?
  verificationStatus String?
  verifiedAt         DateTime?

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  producer Producer? @relation(fields: [producerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId])
  @@index([producerId])
  @@index([scheme])
  @@index([year])
}

model CompanyDocumentRef {
  id         String  @id @default(cuid())
  companyId  String
  documentId String
  context    String?

  company  Company  @relation(fields: [companyId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([companyId, documentId])
}

model Actor {
  id                 String    @id
  slug               String    @unique
  name               String
  actorType          String
  country            String    @default("NO")
  organizationType   String?
  roleSummary        String
  currentRelevance   String?
  website            String?
  currentStance      String?
  desiredStance      String?
  specificAsk        String?
  priorityTier       String?
  owner              String?
  nextStep           String?
  powerScore         Int?
  interestScore      Int?
  themeTags          String[]
  notes              String?
  metadata           Json?
  verificationStatus String?
  lastVerifiedAt     DateTime?

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id])

  contacts          ActorContact[]
  documentRefs      ActorDocumentRef[]
  relationshipsFrom ActorRelationship[] @relation("ActorRelationshipFrom")
  relationshipsTo   ActorRelationship[] @relation("ActorRelationshipTo")

  @@unique([country, name])
  @@index([actorType])
  @@index([country])
  @@index([priorityTier])
  @@index([currentStance])
  @@index([themeTags], type: Gin)
}

model ActorContact {
  id           String  @id @default(cuid())
  actorId      String
  name         String
  role         String?
  email        String?
  organization String?
  note         String?

  actor Actor @relation(fields: [actorId], references: [id])

  @@index([actorId])
}

model ActorDocumentRef {
  id         String  @id @default(cuid())
  actorId    String
  documentId String
  context    String?

  actor    Actor    @relation(fields: [actorId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@unique([actorId, documentId])
  @@index([documentId])
}

model ActorRelationship {
  id           String    @id @default(cuid())
  fromActorId  String
  toActorId    String
  relationType String
  strength     String?
  note         String?
  source       String?
  sourceUrl    String?
  metadata     Json?
  verifiedAt   DateTime?

  fromActor Actor @relation("ActorRelationshipFrom", fields: [fromActorId], references: [id])
  toActor   Actor @relation("ActorRelationshipTo", fields: [toActorId], references: [id])

  @@unique([fromActorId, toActorId, relationType])
  @@index([fromActorId])
  @@index([toActorId])
  @@index([relationType])
}

// ─── Domain 5b: Corporate Structure & Relationships ────────────────

model CompanyOwnership {
