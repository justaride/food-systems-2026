  personKey      String    @unique
  roles          Json[] // {companyId, companyName, role, fromYear, toYear}
  biography      String?
  linkedInUrl    String?
  photoUrl       String?
  affiliations   String[]
  tags           String[]
  metadata       Json?
  lastVerifiedAt DateTime?

  @@index([personKey])
  @@index([tags], type: Gin)
}

