  @@index([reportCategory])
  @@index([country])
  @@index([provenanceType])
  @@index([tags], type: Gin)
}

model EvidenceAppraisal {
  id                    String                     @id @default(cuid())
  reportId              String?                    @unique
  thesisId              String?                    @unique
  sourceDocId           String?                    @unique
  status                EvidenceAppraisalStatus    @default(draft)
  basis                 EvidenceAppraisalBasis?
  studyDesign           EvidenceStudyDesign?
  studyDesignDetails    String?
  methodologySummary    String?
  sampleOrCoverage      String?
  applicability         EvidenceApplicability?
  applicabilityContext  String?
  applicabilityNotes    String?
  limitationsStatus     EvidenceLimitationsStatus?
  limitations           String[]                   @default([])
  limitationsNotes      String?
  riskOfBias            EvidenceRiskOfBias?
  riskOfBiasNotes       String?
  framework             String?
  frameworkVersion      String?
  reviewMethod          EvidenceReviewMethod?
  reviewBasisCitationId String?
  reviewedSourceHash    String?
  hashAlgorithm         String                     @default("sha256")
  reviewedBy            String?
  reviewedAt            DateTime?
  notApplicableReason   String?
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  report              Report?         @relation(fields: [reportId], references: [id], onDelete: Restrict)
  thesis              Thesis?         @relation(fields: [thesisId], references: [id], onDelete: Restrict)
  sourceDoc           SourceDoc?      @relation(fields: [sourceDocId], references: [id], onDelete: Restrict)
  reviewBasisCitation SourceCitation? @relation("EvidenceAppraisalReviewBasis", fields: [reviewBasisCitationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([basis])
  @@index([riskOfBias])
  @@index([reviewBasisCitationId])
}

// ─── Domain 5: Companies ────────────────────────────────────────────

model Company {
  id                  String    @id @default(cuid())
  name                String
  orgNr               String    @unique
  legalForm           String?
  founded             Int?
  naceCode            String?
  naceDescription     String?
  country             String    @default("NO")
  hqAddress           String?
  hqCity              String?
  employees           Int?
  ownershipType       String? // family, cooperative, state, foreign, listed
  valueChainStage     String? // retail, processing, seafood, inputs, logistics
  metadata            Json?
  isResearchConstruct Boolean   @default(false)
  orgNrFormat         String    @default("bronnoysund")
  registrySource      String?
  registryVerifiedAt  DateTime?
  lastBrregRefreshAt  DateTime?

  financials   CompanyFinancial[]
  shareholders Shareholder[]
  boardMembers BoardMember[]
  subsidies    Subsidy[]
  documentRefs CompanyDocumentRef[]
  actor        Actor?

  parentOf          CompanyOwnership[]       @relation("ParentCompany")
  childOf           CompanyOwnership[]       @relation("ChildCompany")
  ownedProperties   CompanyProperty[]        @relation("PropertyOwner")
  tenantProperties  CompanyProperty[]        @relation("PropertyTenant")
  relationshipsFrom BusinessRelationship[]   @relation("RelationshipFrom")
  relationshipsTo   BusinessRelationship[]   @relation("RelationshipTo")
  aquacultureSites  AquacultureSite[]
  aquacultureApps   AquacultureApplication[]
